# --- App & Auth ---
# Kanonik domain: www. Search Console'a https://www.nakliyatdiyari.com ekleyin.
BETTER_AUTH_URL=https://www.nakliyatdiyari.com
BETTER_AUTH_SECRET=<256bit-hex-kod>
ALLOWED_ORIGINS=https://nakliyatdiyari.com,https://www.nakliyatdiyari.com

# --- PostgreSQL (DATABASE_URL otomatik olusur) ---
DB_NAME=nakliyat_diyari
DB_USER=nakliyat_user
DB_PASSWORD=Nak1212

# Port: external 3800 -> container 3000
# Cloudflare Tunnel -> localhost:3800

# --- Deploy (Portainer stack env) ---
# GitHub Actions GHCR'a pushlar, Portainer webhook ile yeniden çeker.
# APP_IMAGE=ghcr.io/<github-kullanici-adi>/nakliyat-diyari:latest